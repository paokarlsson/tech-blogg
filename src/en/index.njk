---
layout: base.njk
title: Home
---
<header class="hero hero--simple">
  <div class="wrap hero-inner">
    <div>
      <p class="eyebrow">{{ metadata.title }}</p>
      <h1>{{ t.siteDescription }}</h1>
    </div>
  </div>
</header>
<main>
  <div class="wrap">
    <div class="postlist">
      {% for post in collections.posts_en %}
      <article class="postlist-item">
        <a href="{{ post.url }}">
          <time class="postmeta" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate(lang) }}</time>
          <h2>{{ post.data.title }}</h2>
          {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</main>
