---
permalink: /en/feed.xml
eleventyExcludeFromCollections: true
---
{%- set t = i18n[lang] -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ metadata.title }}</title>
  <subtitle>{{ t.siteDescription }}</subtitle>
  <link href="{{ metadata.url }}/en/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ metadata.url }}/en/"/>
  <updated>{{ collections.posts_en | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ metadata.url }}/en/</id>
  <author>
    <name>{{ metadata.author.name }}</name>
  </author>
  {%- for post in collections.posts_en %}
  {%- set postUrl = metadata.url + post.url %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ postUrl }}"/>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ postUrl }}</id>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    <content type="html">{{ post.templateContent | transformWithHtmlBase(metadata.url + "/", post.url) | htmlToAbsoluteUrls(postUrl) }}</content>
  </entry>
  {%- endfor %}
</feed>
