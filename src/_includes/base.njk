<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% if title %}{{ title }} – {% endif %}{{ metadata.title }}</title>
<meta name="description" content="{{ description or metadata.description }}">
<link rel="stylesheet" href="/css/style.css">
<link rel="alternate" type="application/rss+xml" title="{{ metadata.title }}" href="/feed.xml">
</head>
<body>
<nav class="sitenav">
  <div class="wrap">
    <a class="brand" href="/">{{ metadata.title }}</a>
    <div class="navlinks">
      <a href="/">Alla inlägg</a>
      <a href="/feed.xml">RSS</a>
    </div>
  </div>
</nav>
{{ content | safe }}
<footer><div class="wrap">{{ metadata.title }} — {{ metadata.description }}</div></footer>
</body>
</html>
